#!/bin/bash

length=${1:-16}
chars='A-Za-z0-9!@#$%^&*()_+=-'

while :; do
    pass=$(LC_ALL=C tr -dc "$chars" </dev/urandom | head -c "$length")

    printf '%s' "$pass" | grep -q '[a-z]' &&
    printf '%s' "$pass" | grep -q '[A-Z]' &&
    printf '%s' "$pass" | grep -q '[0-9]' &&
    printf '%s' "$pass" | grep -q '[!@#$%^&*()_+=-]' &&
    {
        printf '%s\n' "$pass"
        break
    }
done
