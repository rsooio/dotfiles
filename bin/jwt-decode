#!/bin/bash

set -euo pipefail

if [[ $# -gt 1 ]]; then
  echo "Usage: jwt [token]" >&2
  exit 1
fi

if [[ $# -eq 1 ]]; then
  token="$1"
else
  IFS= read -r token || true
fi

if [[ -z "${token:-}" ]]; then
  echo "Usage: jwt [token]" >&2
  exit 1
fi

IFS='.' read -r header payload signature <<< "$token"
HEADER=$(echo "$header" | base64 --decode)
PAYLOAD=$(echo "$payload" | base64 --decode)
echo "{\"header\":$HEADER,\"payload\":$PAYLOAD}"
