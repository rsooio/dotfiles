#!/bin/bash

set -euo pipefail

if [[ $# -gt 1 ]]; then
  echo "Usage: jwt [token]" >&2
  exit 1
fi

if [[ $# -eq 1 ]]; then
  token="$1"
else
  IFS= read -r token || true
fi

if [[ -z "${token:-}" ]]; then
  echo "Usage: jwt [token]" >&2
  exit 1
fi

printf '%s\n' "$token" | jq -R '
  def decode:
    gsub("-"; "+")
    | gsub("_"; "/")
    | . + ("=" * ((4 - (length % 4)) % 4))
    | @base64d
    | fromjson;

  split(".") as $segments
  | if ($segments | length) != 3 then
      error("invalid JWT: expected 3 segments")
    else
      {
        header: ($segments[0] | decode),
        payload: ($segments[1] | decode)
      }
    end
'
